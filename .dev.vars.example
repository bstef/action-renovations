# Copy this file to `.dev.vars` for local development (never commit `.dev.vars`).
# In production, set this as a secret on the Cloudflare Pages project instead:
#   wrangler pages secret put ZAPIER_LEAD_WEBHOOK_URL
#
# This should be a "Catch Hook" trigger URL from a Zapier Zap (Webhooks by Zapier -> Housecall Pro: Create Lead).
# See README.md for how to set up the Zap.
ZAPIER_LEAD_WEBHOOK_URL=
