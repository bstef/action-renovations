---

<footer class="bg-ink text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 grid grid-cols-1 md:grid-cols-4 gap-10">
    <div>
      <img src="/images/brand/logo-white.png" alt={companyInfo.name} class="h-12 w-auto mb-4" />
      <p class="text-white/60 text-sm leading-relaxed">
        Value-adding home renovations across {companyInfo.serviceRegion}. Licensed, insured, and focused on
        craftsmanship that lasts.
      </p>
      <a href={companyInfo.phoneHref} class="mt-4 block text-gold-300 font-semibold hover:text-gold-200">
        {companyInfo.phone}
      </a>
      <p class="mt-3 text-white/70 text-sm font-display font-bold tracking-wide">
        NJ HIC License #{companyInfo.njHicLicense}
      </p>
    </div>
    <div>
      <h3 class="font-display font-semibold uppercase tracking-wide text-sm text-white/90 mb-4">Services</h3>
      <ul class="space-y-2 text-sm text-white/60">
        {services.map((service) => (
          <li><a href={`/services/${service.slug}`} class="hover:text-gold-300 transition-colors">{service.name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="font-display font-semibold uppercase tracking-wide text-sm text-white/90 mb-4">Service Area</h3>
      <ul class="space-y-2 text-sm text-white/60">
        {serviceAreas.map((area) => (
          <li>{area}</li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="font-display font-semibold uppercase tracking-wide text-sm text-white/90 mb-4">Company</h3>
      <ul class="space-y-2 text-sm text-white/60">
        <li><a href="/about" class="hover:text-gold-300 transition-colors">About Us</a></li>
        <li><a href="/our-work" class="hover:text-gold-300 transition-colors">Our Work</a></li>
        <li><a href="/reviews" class="hover:text-gold-300 transition-colors">Customer Reviews</a></li>
        <li><a href="/social" class="hover:text-gold-300 transition-colors">Follow Us</a></li>
        <li><a href="/financing" class="hover:text-gold-300 transition-colors">Financing</a></li>
        <li><a href="/service-area" class="hover:text-gold-300 transition-colors">Service Area</a></li>
        <li><a href="/contact" class="hover:text-gold-300 transition-colors">Contact Us</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 flex flex-col lg:flex-row items-center justify-between gap-6">
      <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-white/40 flex-shrink-0">We Accept</p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          {paymentMethods.map((method) => (
            <div class="flex h-9 w-14 items-center justify-center rounded-md bg-white p-1.5 shadow-sm" title={method.name}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox={method.viewBox} class="h-full w-full" role="img" aria-label={method.name} set:html={method.svg} />
            </div>
          ))}
        </div>
      </div>
      <a
        href="/financing"
        class="flex-shrink-0 inline-flex items-center gap-2.5 rounded-lg bg-white px-4 py-2 shadow hover:shadow-md transition-shadow"
      >
        <span class="text-xs font-semibold uppercase tracking-wide text-ink/50">Financing by</span>
        <img src="/images/financing/hfs-logo.webp" alt="HFS Financial — Home Improvement Loans" class="h-6 w-auto" />
      </a>
    </div>
  </div>
  <div class="border-t border-white/10">
    <!--
      Extra right padding (lg) and bottom padding (below lg) keep this row out from under the Housecall Pro
      chat bubble, whose fixed ~110x150px frame covers the bottom-right corner of the viewport.
    -->
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:pl-8 lg:pr-36 2xl:pr-8 pt-6 pb-28 lg:pb-6 flex flex-col lg:flex-row items-center justify-between gap-4 text-sm font-display font-semibold text-white/50">
      <div class="text-center lg:text-left space-y-1">
        <p>&copy; {year} {companyInfo.name}. All rights reserved.</p>
        <p>Proudly serving {companyInfo.serviceRegion} and surrounding areas.</p>
      </div>
      <div class="flex items-center gap-3">
        {socialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Action Renovations on ${link.name}`}
            class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white/70 hover:bg-gold-400 hover:text-ink transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true">
              <path fill="currentColor" d={link.iconPath} />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
