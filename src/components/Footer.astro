---
import { companyInfo, serviceAreas, services, socialLinks } from '../data/services';
const year = new Date().getFullYear();

// Full-color "we accept" marks on white chips. Wordmark shapes are from Simple Icons (CC0), recolored
// with each brand's colors; Mastercard's circles and Google's four-color G are drawn directly. viewBox is
// cropped to each mark's real bounds so wide wordmarks (Visa, Discover) fill the chip instead of shrinking.
