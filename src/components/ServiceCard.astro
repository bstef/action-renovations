---
import type { Service } from '../data/services';

interface Props {
  service: Service;
}
const { service } = Astro.props;
---

<a href={`/services/${service.slug}`} class="group block overflow-hidden rounded-xl bg-white shadow-md ring-1 ring-black/5 hover:shadow-xl transition-shadow">
  <div class="relative h-56 overflow-hidden">
    <img
      src={service.image}
      alt={service.name}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-black/0"></div>
  </div>
  <div class="p-6">
    <h3 class="font-display text-xl font-bold text-ink mb-2">{service.name}</h3>
    <p class="text-sm text-ink/60 leading-relaxed mb-4">{service.shortDescription}</p>
    <span class="inline-flex items-center gap-1 text-sm font-bold uppercase tracking-wide text-gold-600 group-hover:text-gold-700">
      View Service
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </span>
  </div>
</a>
