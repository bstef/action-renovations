---
import { companyInfo, services } from '../data/services';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about' },
  { label: 'Service Area', href: '/service-area' },
  { label: 'Our Work', href: '/our-work' },
  { label: 'Financing', href: '/financing' },
  { label: 'Contact Us', href: '/contact' },
];

const currentPath = Astro.url.pathname;
const isServicesActive = currentPath.startsWith('/services');
---

<header class="sticky top-0 z-50">
  <div class="bg-ink text-white text-sm">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex items-center justify-between h-9">
      <span class="hidden sm:block tracking-wide text-white/80">{companyInfo.tagline}</span>
      <a href={companyInfo.phoneHref} class="ml-auto flex items-center gap-1.5 font-medium text-white hover:text-gold-300 transition-colors">
        {companyInfo.phone}
      </a>
    </div>
  </div>
  <div class="bg-white border-b border-black/5 shadow-sm">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-20 items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <img src="/images/brand/logo-dark.png" alt={companyInfo.name} class="h-11 w-auto" />
        </a>
        <nav class="hidden lg:flex items-center gap-8">
          <a
            href={navItems[0].href}
            class:list={[
              'text-sm font-semibold uppercase tracking-wide transition-colors',
              currentPath === navItems[0].href ? 'text-gold-600' : 'text-ink hover:text-gold-600',
            ]}
          >
            {navItems[0].label}
          </a>
          <a
            href={navItems[1].href}
            class:list={[
              'text-sm font-semibold uppercase tracking-wide transition-colors',
              currentPath.startsWith(navItems[1].href) ? 'text-gold-600' : 'text-ink hover:text-gold-600',
            ]}
          >
            {navItems[1].label}
          </a>

          <div class="relative group">
            <a
              href="/services"
              class:list={[
                'flex items-center gap-1 text-sm font-semibold uppercase tracking-wide transition-colors',
                isServicesActive ? 'text-gold-600' : 'text-ink hover:text-gold-600',
              ]}
            >
              Services
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <div class="absolute left-1/2 -translate-x-1/2 top-full pt-3 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-150 z-50">
              <div class="w-64 rounded-lg bg-white shadow-xl ring-1 ring-black/10 py-2">
                {services.map((service) => (
                  <a
                    href={`/services/${service.slug}`}
                    class="block px-4 py-2 text-sm font-medium text-ink hover:bg-gold-50 hover:text-gold-700 transition-colors"
                  >
                    {service.name}
                  </a>
                ))}
                <div class="border-t border-black/5 mt-2 pt-2">
                  <a href="/services" class="block px-4 py-2 text-sm font-bold uppercase tracking-wide text-gold-600 hover:text-gold-700">
                    View All Services
                  </a>
                </div>
              </div>
            </div>
          </div>

          {navItems.slice(2).map((item) => (
            <a
              href={item.href}
              class:list={[
                'text-sm font-semibold uppercase tracking-wide transition-colors',
                currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                  ? 'text-gold-600'
                  : 'text-ink hover:text-gold-600',
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="hidden lg:block">
          <a
            href="/contact"
            class="inline-flex items-center rounded-md bg-gold-400 px-5 py-2.5 text-sm font-bold uppercase tracking-wide text-ink shadow hover:bg-gold-300 transition-colors"
          >
            Get a Free Quote
          </a>
        </div>
        <button
          id="mobile-menu-button"
          class="lg:hidden inline-flex items-center justify-center rounded-md p-2 text-ink"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
      <nav id="mobile-menu" class="hidden lg:hidden pb-6">
        <div class="flex flex-col gap-4">
          <a href={navItems[0].href} class="text-sm font-semibold uppercase tracking-wide text-ink hover:text-gold-600">
            {navItems[0].label}
          </a>
          <a href={navItems[1].href} class="text-sm font-semibold uppercase tracking-wide text-ink hover:text-gold-600">
            {navItems[1].label}
          </a>

          <details class="group">
            <summary class="flex items-center justify-between text-sm font-semibold uppercase tracking-wide text-ink hover:text-gold-600 cursor-pointer list-none">
              <a href="/services" class="hover:text-gold-600">Services</a>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="mt-3 flex flex-col gap-3 pl-4 border-l-2 border-gold-200">
              {services.map((service) => (
                <a href={`/services/${service.slug}`} class="text-sm font-medium text-ink/70 hover:text-gold-600">
                  {service.name}
                </a>
              ))}
            </div>
          </details>

          {navItems.slice(2).map((item) => (
            <a href={item.href} class="text-sm font-semibold uppercase tracking-wide text-ink hover:text-gold-600">
              {item.label}
            </a>
          ))}
          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-md bg-gold-400 px-5 py-2.5 text-sm font-bold uppercase tracking-wide text-ink shadow hover:bg-gold-300"
          >
            Get a Free Quote
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  button?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') === false;
    menu?.classList.toggle('hidden');
    button.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
