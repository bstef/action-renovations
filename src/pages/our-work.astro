---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import ContactStrip from '../components/ContactStrip.astro';
import { services } from '../data/services';
---

<!--
  NOTE FOR ACTION RENOVATIONS: This page currently shows one representative photo per
  service category. Swap in real completed-job photos here as they become available —
  ideally grouped by actual project/address for a true portfolio/case-study feel.
-->
<Layout
  title="Our Work | Action Renovations LLC | Morris County, NJ"
  description="Browse examples of Action Renovations LLC's renovation work across Morris County, NJ, by service category."
>
  <section class="relative h-72 flex items-center overflow-hidden">
    <img src="/images/services/bathroom.jpg" alt="Renovation project examples" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold text-white">Our Work</h1>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14 max-w-2xl mx-auto">
        <p class="text-gold-600 font-semibold uppercase tracking-widest text-sm mb-3">See Our Work</p>
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-ink mb-4">A Look at What We Do</h2>
        <p class="text-ink/60">
          A sample of our craftsmanship across categories. Every home is different — reach out to see examples
          closer to what you have in mind.
        </p>
      </div>
      <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
        {services.map((service) => (
          <a href={`/services/${service.slug}`} class="group block break-inside-avoid overflow-hidden rounded-xl shadow-md ring-1 ring-black/5 relative">
            <img src={service.image} alt={service.name} loading="lazy" class="w-full object-cover transition-transform duration-500 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/0 to-black/0"></div>
            <div class="absolute bottom-0 left-0 p-4">
              <p class="text-white font-display font-bold">{service.name}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <ContactStrip />
</Layout>
