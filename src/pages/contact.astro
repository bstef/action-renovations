---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import { companyInfo, serviceAreas } from '../data/services';
---

<Layout
  title="Contact Us | Action Renovations LLC | Morris County, NJ"
  description="Get in touch with Action Renovations LLC for a free renovation quote in Morris County, NJ. Call, chat, or request a quote online."
>
  <section class="relative h-72 flex items-center overflow-hidden">
    <img src="/images/hero-banner.jpg" alt="Contact Action Renovations" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold text-white">Contact Us</h1>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-5 gap-14">
      <div class="lg:col-span-2">
        <p class="text-gold-600 font-semibold uppercase tracking-widest text-sm mb-3">We're Here When You Need Us</p>
        <h2 class="font-display text-3xl font-bold text-ink mb-6">Let's Talk About Your Project</h2>
        <p class="text-ink/60 leading-relaxed mb-8">
          Got questions that need answered? Give us a call today, or send us your project details and a member of
          our team will follow up shortly.
        </p>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="h-11 w-11 rounded-full bg-gold-100 flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-ink">Call Us</p>
              <a href={companyInfo.phoneHref} class="text-ink/60 hover:text-gold-600">{companyInfo.phone}</a>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="h-11 w-11 rounded-full bg-gold-100 flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-ink">Service Area</p>
              <p class="text-ink/60">{serviceAreas.join(', ')}</p>
            </div>
          </div>
        </div>
      </div>
      <div class="lg:col-span-3">
        <LeadForm />
      </div>
    </div>
  </section>
</Layout>
