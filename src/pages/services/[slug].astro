---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { services } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const otherServices = services.filter((s) => s.slug !== service.slug).slice(0, 3);
---

<Layout
  title={`${service.name} | Action Renovations LLC | Morris County, NJ`}
  description={service.shortDescription}
>
  <section class="relative h-80 flex items-end overflow-hidden">
    <img src={service.image} alt={service.name} class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-black/10"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-10 w-full">
      <a href="/services" class="text-white/70 text-sm font-semibold hover:text-white">&larr; All Services</a>
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold text-white mt-2">{service.name}</h1>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2">
        <p class="text-ink/70 leading-relaxed text-lg mb-8">{service.longDescription}</p>
        <h2 class="font-display text-xl font-bold text-ink mb-4">What's Included</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
          {service.highlights.map((h) => (
            <li class="flex items-start gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gold-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-ink/70">{h}</span>
            </li>
          ))}
        </ul>

        <div class="rounded-xl bg-gray-50 ring-1 ring-black/5 p-8">
          <h2 class="font-display text-xl font-bold text-ink mb-3">Explore More Services</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            {otherServices.map((s) => <ServiceCard service={s} />)}
          </div>
        </div>
      </div>
      <div>
        <div class="sticky top-28">
          <LeadForm heading={`Get a Quote for ${service.name}`} subheading="Tell us about your project and we'll follow up shortly." />
        </div>
      </div>
    </div>
  </section>
</Layout>
