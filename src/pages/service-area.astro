---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import ContactStrip from '../components/ContactStrip.astro';
import { serviceAreas, companyInfo } from '../data/services';
---

<Layout
  title="Service Area | Morris County, NJ | Action Renovations LLC"
  description="Action Renovations LLC proudly serves Morristown, Bernardsville, Mendham, Rockaway, Cedar Knolls, and all of Morris County, NJ."
>
  <section class="relative h-72 flex items-center overflow-hidden">
    <img src="/images/hero-banner.jpg" alt="Morris County, NJ" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold text-white">Service Area</h1>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center mb-14">
      <p class="text-gold-600 font-semibold uppercase tracking-widest text-sm mb-3">Where We Work</p>
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-ink mb-6">
        Proudly Serving the Whole County of Morris County and Surrounding Areas
      </h2>
      <p class="text-ink/60 leading-relaxed text-lg">
        Contact us today to see if we service your neighborhood — and if you're just outside the list below, reach
        out anyway. We're often happy to travel for the right project.
      </p>
    </div>
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        {serviceAreas.map((area) => (
          <div class="flex items-center gap-3 rounded-lg bg-gray-50 ring-1 ring-black/5 px-4 py-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gold-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="font-semibold text-ink">{area}</span>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href={companyInfo.phoneHref} class="inline-flex items-center rounded-md bg-gold-400 px-7 py-3.5 text-sm font-bold uppercase tracking-wide text-ink shadow hover:bg-gold-300 transition-colors">
          Call Us: {companyInfo.phone}
        </a>
      </div>
    </div>
  </section>

  <ContactStrip />
</Layout>
