---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { companyInfo } from '../data/services';
---

<Layout title="Page Not Found | Action Renovations LLC" description="The page you're looking for couldn't be found.">
  <section class="py-32 bg-white text-center">
    <div class="mx-auto max-w-xl px-4">
      <p class="font-display text-6xl font-extrabold text-gold-400 mb-4">404</p>
      <h1 class="font-display text-2xl font-bold text-ink mb-4">Page Not Found</h1>
      <p class="text-ink/60 mb-8">
        We couldn't find the page you were looking for. Head back home, or give us a call at
        <a href={companyInfo.phoneHref} class="text-gold-600 font-semibold">{companyInfo.phone}</a>.
      </p>
      <a href="/" class="inline-flex items-center rounded-md bg-gold-400 px-7 py-3.5 text-sm font-bold uppercase tracking-wide text-ink shadow hover:bg-gold-300 transition-colors">
        Back to Home
      </a>
    </div>
  </section>
</Layout>
